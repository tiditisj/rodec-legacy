---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import ModelCard from '../components/ModelCard.astro';
import { models, docs, archive, bySlug } from '../lib/data';
import { MILESTONES } from '../data/content';
import { LINKS } from '../data/site';

const featured = ['cu881', 'mixfan', 'mx18', 'mx180', 'mx180-mkiii', 'mixbox', 'scratchbox', 'restyler']
  .map((s) => bySlug.get(s)!).filter(Boolean);
const brochureCount = models.reduce((n, m) => n + m.brochures.length, 0) + archive.brochures.length;
const stats = [
  { n: '1954', l: 'Founded in Antwerp' },
  { n: String(models.filter((m) => !m.curiosity).length), l: 'Models in the archive' },
  { n: String(docs.length), l: 'Manuals & schematics' },
  { n: String(brochureCount + archive.press.length), l: 'Brochures, ads & reviews' },
];
// Scans from the paper archive boxes carry "/box-" in their media path.
const isBox = (i?: { src: string }) => !!i?.src.includes('/box-');
const allPages = [
  ...models.flatMap((m) => [...m.photos, ...m.brochures.flatMap((b) => b.pages)]),
  ...archive.brochures.flatMap((b) => b.pages), ...archive.press.flatMap((b) => b.pages), ...archive.history,
];
const boxCount = allPages.filter(isBox).length;
const boxPool = [...archive.history, ...archive.brochures.map((b) => ({ ...b.pages[0], caption: b.title })),
  ...archive.press.map((b) => ({ ...b.pages[0], caption: b.title }))].filter(isBox);
const boxPicks = ['Rodec 25!', 'Rodec Radio, Lange', 'Stereo Technic', 'Rodec celebrates', 'In the Rodec lab']
  .map((t) => boxPool.find((i) => i.caption?.startsWith(t))).filter(Boolean) as typeof boxPool;
// Crossfader: every Rodec with a photo, in order of release.
const xfModels = models.filter((m) => !m.curiosity && !m.name.startsWith('Donalbi') && m.photos.length && m.year)
  .map((m) => ({ src: m.photos[0].thumb, year: m.year, name: m.name, slug: m.slug }));
const xfFirst = xfModels[0], xfLast = xfModels[xfModels.length - 1];
---
<Base jsonLd={[
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://rodec.com/#organization',
    name: 'Rodec',
    url: LINKS.rodec,
    logo: new URL('/brand/rodec-wordmark.svg', Astro.site).href,
    foundingDate: '1954',
    foundingLocation: { '@type': 'Place', name: 'Antwerp, Belgium' },
    founder: { '@type': 'Person', name: 'Roger De Clercq' },
    slogan: 'Serving DJs since 1954',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Rodec Legacy',
    url: new URL('/', Astro.site).href,
    inLanguage: 'en',
    publisher: { '@id': 'https://rodec.com/#organization' },
  },
]}>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__img" aria-hidden="true">
      <img src="/media/models/mx240-mkiii/mx240-mkiii-front-grey-004.webp" alt="" fetchpriority="high" />
    </div>
    <div class="wrap hero__inner">
      <p class="label hero__kicker"><span class="led"></span>&nbsp; The Rodec archive · 1954 – 2014</p>
      <h1 class="hero__title">
        <span>Serving</span>
        <span>DJ’s since</span>
        <span class="hero__year">1954<sup>®</sup></span>
      </h1>
      <p class="lede">From a radio shop in Antwerp to the booths of Fuse, Cocoon and Amnesia: this is the story of the Belgian brand that gave every channel its own EQ.</p>
      <div class="hero__cta">
        <a class="btn btn--red" href="/models/">Explore all models →</a>
        <a class="btn" href="/manuals/">Manuals & schematics</a>
      </div>
    </div>
    <div class="hero__strip wrap">
      {stats.map((s) => (
        <div class="stat"><span class="stat__n display">{s.n}</span><span class="label">{s.l}</span></div>
      ))}
    </div>
  </section>

  <!-- CROSSFADER -->
  <section class="section">
    <div class="wrap xf-wrap">
      <div class="xf__text reveal">
        <p class="label red">Crossfade through time</p>
        <h2>Half a century on one fader.</h2>
        <p class="lede">From the {xfFirst.year} {xfFirst.name} to the {xfLast.year} {xfLast.name}: {xfModels.length} Rodecs in order of release. Grab the crossfader and slide through the decades.</p>
      </div>
      <div class="xf reveal alu screws" data-models={JSON.stringify(xfModels)}>
        <div class="xf__screen">
          <img class="xf__img xf__a" src={xfFirst.src} alt={`Rodec ${xfFirst.name}, ${xfFirst.year}`} />
          <img class="xf__img xf__b" src={xfModels[1].src} alt="" style="opacity:0" />
          <a class="xf__tag" href={`/models/${xfFirst.slug}/`}>{xfFirst.year} · {xfFirst.name}</a>
          <span class="xf__count label">1 / {xfModels.length}</span>
        </div>
        <div class="xf__deck">
          <span class="label">{xfFirst.year}</span>
          <div class="xf__track">
            <input type="range" min="0" max={(xfModels.length - 1) * 100} value="0" aria-label={`Crossfade through ${xfModels.length} Rodec models, ${xfFirst.year} to ${xfLast.year}`} />
            <div class="xf__ticks"></div>
          </div>
          <span class="label">{xfLast.year}</span>
        </div>
        <p class="label xf__silk">Crossfader · curve: smooth</p>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section class="section tl">
    <div class="wrap tl__head">
      <div>
        <p class="label red">Timeline</p>
        <h2>Seven decades<br />on the faders</h2>
      </div>
      <a class="btn" href="/history/">Read the full story →</a>
    </div>
    <div class="tl__rail" tabindex="0" aria-label="Rodec timeline, scroll horizontally">
      {MILESTONES.map((m) => {
        const model = m.model ? bySlug.get(m.model) : undefined;
        const img = model?.photos[0] ?? model?.brochures[0]?.pages[0];
        return (
          <article class="tl__item">
            <span class="tl__year display">{m.year}</span>
            <div class="tl__card">
              {m.image
                ? <img src={m.image.src} alt={m.image.alt} loading="lazy" class:list={[m.image.cover && 'tl__img--cover']} style={m.image.position ? `object-position:${m.image.position}` : undefined} />
                : img && <img src={img.thumb} alt={img.alt} loading="lazy" />}
              <h3>{m.title}</h3>
              <p>{m.text}</p>
              {model && <a class="label" href={`/models/${model.slug}/`}>{model.name} →</a>}
              {m.link && <a class="label" href={m.link.href} rel="noopener">{m.link.label} ↗</a>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- FEATURED -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="label red">Hall of fame</p><h2>Icons</h2></div>
        <a class="btn" href="/models/">All {models.length} models →</a>
      </div>
      <div class="grid grid--models reveal">
        {featured.map((m) => <ModelCard model={m} />)}
      </div>
    </div>
  </section>

  <!-- ARCHIVE BOXES -->
  {boxPicks.length > 0 && (
    <section class="section">
      <div class="wrap boxes">
        <div class="boxes__text reveal">
          <p class="label red">New · out of the boxes</p>
          <h2>Never seen<br />outside the box</h2>
          <p class="lede">We went through the Rodec archive boxes and scanned everything worth sharing: original press photos, 1970s folders, complete service manuals, Japanese adverts and photos from the workshop. Most of it only existed on paper until now. {boxCount} high-resolution scans, free for everyone.</p>
          <p class="boxes__thanks">With thanks to the <a href={LINKS.huisVanAlijn} rel="noopener">Huis van Alijn</a> in Ghent for browsing the boxes and doing the scanning.</p>
          <div class="hero__cta">
            <a class="btn btn--red" href="/archive/#boxes">See what we found →</a>
          </div>
        </div>
        <div class="boxes__collage reveal">
          {boxPicks.map((i) => (
            <a href={i.src} data-lightbox="boxes" data-caption={i.caption}><img src={i.thumb} alt={i.alt} loading="lazy" /></a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- BOOK -->
  <section class="section">
    <div class="wrap book">
      <a class="book__cover reveal" href="/archive/#book">
        <img src={archive.book[0]?.src} alt="Cover of the Rodec 50 years book, Perpetual Music Makers" loading="lazy" />
      </a>
      <div class="reveal">
        <p class="label red">From the archive</p>
        <h2>Perpetual<br />music makers</h2>
        <p class="lede">The 50th-anniversary book: {archive.book.length} pages with every model, original specs and launch prices. Plus decades of brochures, adverts and magazine reviews.</p>
        <div class="hero__cta">
          <a class="btn btn--red" href="/archive/#book">Leaf through the book</a>
          <a class="btn" href="/archive/#brochures">Brochures & press</a>
        </div>
      </div>
    </div>
  </section>

</Base>

<script>
  // Crossfader: two image layers; slot A shows model i, slot B model i+1, faded by the fraction.
  const xf = document.querySelector<HTMLElement>('.xf');
  if (xf) {
    const list: { src: string; year: number; name: string; slug: string }[] = JSON.parse(xf.dataset.models!);
    const range = xf.querySelector<HTMLInputElement>('input[type=range]')!;
    const a = xf.querySelector<HTMLImageElement>('.xf__a')!, b = xf.querySelector<HTMLImageElement>('.xf__b')!;
    const tag = xf.querySelector<HTMLAnchorElement>('.xf__tag')!, count = xf.querySelector<HTMLElement>('.xf__count')!;
    const seen = new Set<string>();
    const preload = (i: number) => { const m = list[i]; if (m && !seen.has(m.src)) { seen.add(m.src); new Image().src = m.src; } };
    const set = (img: HTMLImageElement, m?: { src: string; name: string; year: number }) => {
      if (!m) return;
      if (!img.src.endsWith(m.src)) img.src = m.src;
      img.alt = `Rodec ${m.name}, ${m.year}`;
    };
    const update = () => {
      const v = Number(range.value) / 100;
      const i = Math.min(Math.floor(v), list.length - 1), f = v - i;
      set(a, list[i]); set(b, list[i + 1]);
      a.style.opacity = String(1 - f); b.style.opacity = String(f);
      const cur = list[f < 0.5 ? i : Math.min(i + 1, list.length - 1)];
      tag.textContent = `${cur.year} · ${cur.name}`;
      tag.href = `/models/${cur.slug}/`;
      count.textContent = `${list.indexOf(cur) + 1} / ${list.length}`;
      for (let k = i - 2; k <= i + 3; k++) preload(k);
    };
    range.addEventListener('input', update);
    range.addEventListener('pointerdown', () => list.forEach((_, k) => k < 12 && preload(k)), { once: true });
  }
</script>

<style>
  /* hero */
  .hero { position: relative; min-height: min(92vh, 900px); display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; padding-top: 80px; }
  .hero__img { position: absolute; inset: 0; }
  .hero__img img { width: 100%; height: 100%; object-fit: cover; object-position: 70% 40%; opacity: .55; transform: scale(1.06); animation: drift 24s ease-in-out infinite alternate; }
  .hero__img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--ink) 15%, rgba(13,12,11,.6) 50%, rgba(13,12,11,.15)), linear-gradient(0deg, var(--ink) 4%, transparent 45%); }
  @keyframes drift { to { transform: scale(1.14) translate(-1.5%, -1%); } }
  .hero__inner { position: relative; padding-bottom: 48px; }
  .hero__kicker { display: flex; align-items: center; margin-bottom: 28px; }
  .hero__title { display: grid; font-size: clamp(3rem, 10.5vw, 9.5rem); line-height: .86; margin-bottom: 32px; }
  .hero__title span { display: block; animation: rise 1s var(--ease) both; }
  .hero__title span:nth-child(2) { animation-delay: .08s; }
  .hero__title span:nth-child(3) { animation-delay: .16s; }
  .hero__year { color: transparent; -webkit-text-stroke: 2px var(--cream); }
  .hero__year sup { font-size: .22em; vertical-align: top; -webkit-text-stroke: 0; color: var(--red); margin-left: .1em; }
  @keyframes rise { from { opacity: 0; transform: translateY(40px); } }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero__strip { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line-2); }
  .stat { padding: 22px 16px 26px 0; display: grid; gap: 6px; border-right: 1px solid var(--line); }
  .stat:not(:first-child) { padding-left: 20px; }
  .stat:last-child { border-right: 0; }
  .stat__n { font-size: clamp(1.8rem, 4vw, 3rem); }
  @media (max-width: 720px) { .hero__strip { grid-template-columns: 1fr 1fr; } .stat:nth-child(2) { border-right: 0; } .stat:nth-child(n+3) { border-top: 1px solid var(--line); } .stat:nth-child(3) { padding-left: 0; } }

  /* crossfader */
  .xf-wrap { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .xf__text h2 { margin: 12px 0 24px; }
  .xf { border-radius: 10px; padding: clamp(18px, 3vw, 32px); padding-top: 36px; }
  .xf__screen { position: relative; aspect-ratio: 16 / 10; border-radius: 4px; overflow: hidden; background: #0b0b0a; box-shadow: inset 0 2px 12px rgba(0,0,0,.8), 0 0 0 1px rgba(0,0,0,.4); }
  .xf__screen { background: #efede8; }
  .xf__screen img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 6%; mix-blend-mode: multiply; }
  .xf__count { position: absolute; top: 12px; right: 12px; color: #6b675f; }
  .xf__tag { position: absolute; bottom: 12px; font-family: var(--mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; padding: 5px 9px; border-radius: 3px; background: var(--ink); color: var(--cream); text-decoration: none; }
  .xf__tag { left: 12px; background: var(--red); }
  .xf__deck { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; margin-top: 24px; }
  .xf__track { position: relative; height: 44px; display: grid; align-items: center; }
  .xf__ticks { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(90deg, #4a4740 0 1px, transparent 1px 10%) center / 100% 30px no-repeat; opacity: .5; }
  .xf input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; background: transparent; position: relative; z-index: 1; margin: 0; cursor: ew-resize; }
  .xf input[type=range]::-webkit-slider-runnable-track { height: 6px; border-radius: 3px; background: #1b1a18; box-shadow: inset 0 1px 2px #000, 0 1px 0 rgba(255,255,255,.5); }
  .xf input[type=range]::-moz-range-track { height: 6px; border-radius: 3px; background: #1b1a18; }
  .xf input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 30px; height: 40px; margin-top: -17px; border-radius: 4px; background: linear-gradient(90deg, #111 0 46%, #eee 46% 54%, #111 54%), #111; box-shadow: 0 6px 10px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.2); border: 1px solid #000; }
  .xf input[type=range]::-moz-range-thumb { width: 30px; height: 40px; border-radius: 4px; background: linear-gradient(90deg, #111 0 46%, #eee 46% 54%, #111 54%); border: 1px solid #000; }
  .xf__silk { text-align: center; margin: 10px 0 0; }
  @media (max-width: 860px) { .xf-wrap { grid-template-columns: 1fr; } }

  /* archive boxes */
  .boxes { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .boxes__text h2 { margin: 12px 0 24px; }
  .boxes__thanks { margin-top: 14px; color: var(--cream-3); font-size: .9rem; }
  .boxes__collage { position: relative; display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-rows: clamp(70px, 9vw, 120px); gap: 12px; }
  .boxes__collage a { position: relative; display: block; overflow: hidden; border-radius: 3px; background: #e9e4d8; box-shadow: 0 18px 30px -16px rgba(0,0,0,.9); transition: transform .4s var(--ease); }
  .boxes__collage a:hover { transform: translateY(-4px) rotate(-.6deg); }
  .boxes__collage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .boxes__collage a:nth-child(1) { grid-column: 1 / 4; grid-row: 1 / 4; }
  .boxes__collage a:nth-child(2) { grid-column: 4 / 7; grid-row: 1 / 3; }
  .boxes__collage a:nth-child(3) { grid-column: 4 / 6; grid-row: 3 / 5; }
  .boxes__collage a:nth-child(4) { grid-column: 1 / 4; grid-row: 4 / 6; }
  .boxes__collage a:nth-child(5) { grid-column: 6 / 7; grid-row: 3 / 6; }
  @media (max-width: 860px) { .boxes { grid-template-columns: 1fr; } }

  /* timeline */
  .tl__head, .sec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 40px; }
  .tl__head h2, .sec-head h2 { margin-top: 12px; }
  .tl__rail { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(270px, 320px); gap: 0; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 0 24px; padding-inline: max(var(--gutter), (100vw - var(--max)) / 2); scroll-padding-inline: max(var(--gutter), (100vw - var(--max)) / 2); scrollbar-width: thin; scrollbar-color: var(--line-2) transparent; position: relative; }
  .tl__item { scroll-snap-align: start; position: relative; padding: 0 16px 0 0; }
  .tl__item::before { content: ''; position: absolute; left: 0; right: 0; top: 74px; height: 1px; background: var(--line-2); }
  .tl__item::after { content: ''; position: absolute; left: 0; top: 70px; width: 9px; height: 9px; border-radius: 50%; background: var(--red); box-shadow: 0 0 12px var(--red); }
  .tl__year { display: block; font-size: 3.2rem; line-height: 1; color: transparent; -webkit-text-stroke: 1px var(--cream-3); height: 64px; transition: color .3s, -webkit-text-stroke-color .3s; }
  .tl__item:hover .tl__year { color: var(--cream); -webkit-text-stroke-color: var(--cream); }
  .tl__card { margin-top: 32px; padding: 18px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--ink-2); min-height: 240px; display: flex; flex-direction: column; gap: 10px; }
  .tl__card img { height: 120px; width: 100%; object-fit: contain; padding: 10px; margin-bottom: 4px; border-radius: 4px; background: radial-gradient(120% 100% at 50% 20%, #f6f4ef, #d8d4cb); }
  .tl__card img.tl__img--cover { object-fit: cover; padding: 0; background: none; }
  .tl__card h3 { font-size: 1.05rem; }
  .tl__card p { font-size: .92rem; color: var(--cream-2); margin: 0; flex: 1; }
  .tl__card a { text-decoration: none; color: var(--cream); }

  /* book */
  .book { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .book__cover { display: block; transform: rotate(-3deg); transition: transform .6s var(--ease); max-width: 440px; }
  .book__cover:hover { transform: rotate(0) scale(1.02); }
  .book__cover img { box-shadow: 30px 40px 60px -20px rgba(0,0,0,.9), 0 0 0 1px rgba(255,255,255,.05); border-radius: 2px 6px 6px 2px; }
  .book h2 { margin: 12px 0 24px; }
  @media (max-width: 860px) { .book { grid-template-columns: 1fr; } .book__cover { max-width: 300px; } }

</style>
