---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { NAV, LINKS } from '../data/site';

interface Props { title?: string; description?: string; image?: string }
const {
  title,
  description = 'The archive of Rodec, the Belgian brand that has been serving DJs since 1954: history, every model, original brochures and all the manuals and schematics we could find.',
  image = '/media/book/ro-000.webp',
} = Astro.props;
const fullTitle = title ? `${title} · Rodec Legacy` : 'Rodec Legacy · Serving DJs since 1954';
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0d0c0b" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="top__inner">
        <a href="/" class="top__logo" aria-label="Rodec Legacy home">
          <Logo />
          <span class="top__tag label">Legacy</span>
        </a>
        <nav class="top__nav" aria-label="Main">
          {NAV.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <button class="top__burger" aria-label="Menu" aria-expanded="false" aria-controls="mnav"><span></span><span></span></button>
      </div>
      <div class="vu" aria-hidden="true">
        {Array.from({ length: 48 }).map((_, i) => <i style={`--i:${i}`}></i>)}
      </div>
    </header>
    <nav id="mnav" class="mnav" aria-label="Mobile">
      {NAV.map((n, i) => <a href={n.href} style={`--d:${i}`}>{n.label}</a>)}
    </nav>

    <main id="main"><slot /></main>

    <footer class="foot">
      <div class="scale"></div>
      <div class="wrap foot__inner">
        <div class="foot__brand">
          <Logo variant="emblem" class="foot__emblem" />
          <p class="display foot__claim">Serving DJ’s<br />since 1954</p>
        </div>
        <div class="foot__cols">
          <div>
            <p class="label">Explore</p>
            {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
          </div>
          <div>
            <p class="label">Useful sources</p>
            <a href="/resources/">All sources</a>
            <a href="/manuals/">Manuals & schematics</a>
            <a href={LINKS.rodec} rel="noopener">rodec.com</a>
          </div>
          <div>
            <p class="label">Got something?</p>
            <p class="foot__small">Own an old brochure, a manual we’re missing or a photo of a Rodec in a club? Help complete the archive.</p>
          </div>
        </div>
      </div>
      <div class="wrap foot__base label">
        <span>© Rodec · Antwerp, Belgium</span>
        <span>Made in Belgium · Archive 1954–2014</span>
      </div>
    </footer>

    <dialog class="lightbox" aria-label="Image viewer">
      <header class="lightbox__head">
        <div class="lightbox__meta">
          <span class="lightbox__cap"></span>
          <span class="label lightbox__count"></span>
        </div>
        <button class="lightbox__btn lightbox__close" aria-label="Close">✕</button>
      </header>
      <div class="lightbox__stage">
        <img alt="" />
        <button class="lightbox__btn lightbox__prev" aria-label="Previous">←</button>
        <button class="lightbox__btn lightbox__next" aria-label="Next">→</button>
      </div>
    </dialog>

    <script>
      // Mobile menu
      const burger = document.querySelector<HTMLButtonElement>('.top__burger')!;
      burger.addEventListener('click', () => {
        const open = document.body.classList.toggle('menu-open');
        burger.setAttribute('aria-expanded', String(open));
      });

      // Reveal on scroll
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Lightbox: any <a data-lightbox="group"> opens in the viewer.
      const dlg = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
      const img = dlg.querySelector('img')!;
      const cap = dlg.querySelector<HTMLElement>('.lightbox__cap')!;
      const count = dlg.querySelector<HTMLElement>('.lightbox__count')!;
      let items: HTMLAnchorElement[] = [];
      let idx = 0;
      const show = (i: number) => {
        idx = (i + items.length) % items.length;
        const a = items[idx];
        img.src = a.href;
        img.alt = a.querySelector('img')?.alt ?? '';
        cap.textContent = a.dataset.caption ?? img.alt;
        count.textContent = `${idx + 1} / ${items.length}`;
      };
      document.addEventListener('click', (ev) => {
        const a = (ev.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
        if (!a || ev.metaKey || ev.ctrlKey) return;
        ev.preventDefault();
        items = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${a.dataset.lightbox}"]`)];
        show(items.indexOf(a));
        dlg.showModal();
      });
      dlg.querySelector('.lightbox__prev')!.addEventListener('click', () => show(idx - 1));
      dlg.querySelector('.lightbox__next')!.addEventListener('click', () => show(idx + 1));
      dlg.querySelector('.lightbox__close')!.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).classList.contains('lightbox__stage')) dlg.close(); });
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(idx - 1);
        if (e.key === 'ArrowRight') show(idx + 1);
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 200; background: var(--amber); color: var(--ink); padding: 8px 14px; }
  .skip:focus { left: 8px; }

  .top { position: sticky; top: 0; z-index: 50; background: rgba(13,12,11,.82); backdrop-filter: blur(14px) saturate(1.4); -webkit-backdrop-filter: blur(14px) saturate(1.4); border-bottom: 1px solid var(--line); }
  .top__inner { width: min(var(--max), 100% - 2 * var(--gutter)); margin-inline: auto; height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .top__logo { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--cream); }
  .top__logo :global(.logo) { width: 118px; }
  .top__tag { border: 1px solid var(--line-2); border-radius: 3px; padding: 2px 6px; color: var(--cream-2); font-size: .62rem; }
  .top__nav { display: flex; gap: 4px; }
  .top__nav a { font-family: var(--mono); font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; color: var(--cream-2); padding: 8px 12px; border-radius: 999px; transition: color .2s, background .2s; }
  .top__nav a:hover { color: var(--cream); background: var(--ink-3); }
  .top__nav a[aria-current='page'] { color: var(--cream); }
  .top__nav a[aria-current='page']::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--red); box-shadow: 0 0 8px var(--red); margin-right: 8px; vertical-align: 2px; }

  /* tiny VU meter under the header */
  .vu { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; display: grid; grid-template-columns: repeat(48, 1fr); gap: 2px; padding-inline: 0; pointer-events: none; }
  .vu i { background: var(--green); opacity: 0; animation: vu 1.8s calc(var(--i) * -37ms) infinite ease-in-out; }
  .vu i:nth-child(n+34) { background: var(--amber); }
  .vu i:nth-child(n+43) { background: var(--red); }
  @keyframes vu { 0%, 100% { opacity: 0; } 40% { opacity: .9; } }

  .top__burger { display: none; width: 44px; height: 44px; border: 1px solid var(--line-2); border-radius: 50%; background: none; cursor: pointer; position: relative; }
  .top__burger span { position: absolute; left: 13px; right: 13px; height: 1.5px; background: var(--cream); transition: transform .3s var(--ease), top .3s var(--ease); }
  .top__burger span:first-child { top: 17px; } .top__burger span:last-child { top: 25px; }
  :global(.menu-open) .top__burger span:first-child { top: 21px; transform: rotate(45deg); }
  :global(.menu-open) .top__burger span:last-child { top: 21px; transform: rotate(-45deg); }

  .mnav { display: none; }
  @media (max-width: 980px) {
    .top__nav { display: none; }
    .top__burger { display: block; }
    .mnav { display: flex; flex-direction: column; position: fixed; inset: 65px 0 0; z-index: 49; background: var(--ink); padding: 32px var(--gutter); gap: 6px; opacity: 0; pointer-events: none; transition: opacity .3s var(--ease); }
    .mnav a { font-family: var(--display); font-stretch: 125%; font-weight: 800; text-transform: uppercase; font-size: clamp(1.8rem, 8vw, 3rem); text-decoration: none; line-height: 1.1; transform: translateY(12px); transition: transform .4s calc(var(--d) * 40ms) var(--ease); }
    :global(.menu-open) .mnav { opacity: 1; pointer-events: auto; }
    :global(.menu-open) .mnav a { transform: none; }
  }

  .foot { margin-top: 80px; border-top: 1px solid var(--line); background: var(--ink-2); }
  .foot .scale { opacity: .5; }
  .foot__inner { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; padding-block: 56px; }
  .foot__brand { display: flex; gap: 20px; align-items: center; }
  .foot__brand :global(.foot__emblem) { width: 64px; color: var(--red); }
  .foot__claim { font-size: 1.4rem; line-height: 1; }
  .foot__cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .foot__cols a { display: block; text-decoration: none; color: var(--cream-2); padding: 3px 0; font-size: .95rem; }
  .foot__cols a:hover { color: var(--cream); }
  .foot__small { font-size: .92rem; color: var(--cream-2); }
  .foot__base { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 20px 32px; border-top: 1px solid var(--line); }
  @media (max-width: 860px) { .foot__inner { grid-template-columns: 1fr; } .foot__cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .foot__cols { grid-template-columns: 1fr; } }
</style>
